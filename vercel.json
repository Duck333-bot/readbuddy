{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": ["dist/vercel-app.mjs", "public/**"]
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
